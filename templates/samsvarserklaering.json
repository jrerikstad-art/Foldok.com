    {
      "section_key": "circuit_schedule",
      "title": "Circuit Schedule",
      "title_no": "Kursfortegnelse",
      "position": 4,
      "required": true,
      "gap_severity": "blocking",
      "required_facts": [
        { "key": "circuit", "fact_type": "spec", "severity": "blocking", "label": "At least one circuit with breaker rating and cable cross-section", "label_no": "Minst én kurs med sikringsstørrelse og kabeltverrsnitt", "cardinality": "one_or_more" }
      ],
      "required_media": { "min_photos": 1, "preferred_roles": ["wiring", "nameplate"] },
      "required_content": ["table_format", "no_uncited_specs", "units_si"],
