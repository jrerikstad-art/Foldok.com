        { "key": "client_name", "fact_type": "identifier", "severity": "warning", "label": "Client / owner name", "label_no": "Kunde / eier" },
        { "key": "meter_no", "fact_type": "identifier", "severity": "warning", "label": "Meter number", "label_no": "Målernummer" }
      ],
      "required_media": {},
