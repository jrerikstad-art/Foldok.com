      "notes": "Measurements must come from extracted facts (photo of instrument display, test report, or user-entered verified values). NEVER inferred or defaulted."
    },
    {
      "section_key": "standards_declaration",
      "title": "Declaration of Conformity",
      "title_no": "Samsvarserklæring",
      "position": 6,
      "required": true,
