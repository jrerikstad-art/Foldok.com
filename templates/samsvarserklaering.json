        { "key": "el_virksomhet_id", "fact_type": "identifier", "severity": "blocking", "label": "Registered electrical enterprise ID (Elvirksomhetsregisteret)", "label_no": "Elvirksomhets-ID" },
        { "key": "company_address", "fact_type": "identifier", "severity": "warning", "label": "Company address", "label_no": "Foretakets adresse" }
