        { "key": "earth_continuity", "fact_type": "measurement", "severity": "blocking", "label": "Earth/protective conductor continuity", "label_no": "Kontinuitet beskyttelsesleder" },
        { "key": "rcd_test", "fact_type": "measurement", "severity": "warning", "label": "RCD trip test result", "label_no": "Test av jordfeilbryter" }
